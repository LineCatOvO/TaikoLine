// ============================================
// 简单分支测试
// ============================================
COURSE:Easy
LEVEL:2
BALLOON:5,7
SCOREINIT:100
SCOREDIFF:10

#START
// 开场
1000100010001000,
2000200020002000,
1000100010001000,
2000200020002000,
// 分支开始
#BRANCHSTART r,1,2
// 普通分支
#N
1000100010001000,
2000200020002000,
// 专家分支
#E
1010101010101010,
2020202020202020,
// 大师分支
#M
1110111011101110,
2220222022202220,
// 分支结束
#BRANCHEND
// 结尾
1000100010001000,
#END

