TITLE:速度变化练习
TITLEEN:Speed Variation Practice
SUBTITLE:~BPM与滚动速度变化~
BPM:120
WAVE:simple_test.wav
OFFSET:0.0
DEMOSTART:0.0
GENRE:练习
SCOREMODE:0
MAKER:TaikoLine Training

// ============================================
// Easy Course - 速度入门（等级2）
// 基础BPM变化体验
// ============================================
COURSE:Easy
LEVEL:2
BALLOON:5
SCOREINIT:80
SCOREDIFF:8

#START
// 基础节奏预热
1000100010001000,
2000200020002000,
// BPM加快体验
#BPMCHANGE:140
1000100010001000,
2000200020002000,
// BPM减慢体验
#BPMCHANGE:100
1000100010001000,
2000200020002000,
// 回到正常速度
#BPMCHANGE:120
1000100010001000,
2000200020002000,
// 滚动速度加快
#SCROLL:1.5
1000100010001000,
#SCROLL:1.0
2000200020002000,
// 滚动速度减慢
#SCROLL:0.75
1000100010001000,
#SCROLL:1.0
2000200020002000,
// 结束练习
1000100020002000,
#END

// ============================================
// Normal Course - 速度进阶（等级4）
// BPM和滚动速度组合变化
// ============================================
COURSE:Normal
LEVEL:4
BALLOON:5,7
SCOREINIT:150
SCOREDIFF:15

#START
// 基础节奏预热
1010101010101010,
2020202020202020,
// BPM变化序列
#BPMCHANGE:150
1010101010101010,
#BPMCHANGE:90
2020202020202020,
#BPMCHANGE:120
// 滚动速度变化序列
#SCROLL:1.5
1010101010101010,
#SCROLL:0.75
2020202020202020,
#SCROLL:1.0
// BPM与滚动组合
#BPMCHANGE:140
#SCROLL:1.25
1010101010101010,
#BPMCHANGE:100
#SCROLL:0.75
2020202020202020,
#BPMCHANGE:120
#SCROLL:1.0
// Go-Go Time速度变化
#GOGOSTART
#BPMCHANGE:150
1110111011101110,
#BPMCHANGE:120
2220222022202220,
#GOGOEND
// 结束
1010101010101010,
#END

// ============================================
// Hard Course - 速度高级（等级6）
// 复杂速度变化模式
// ============================================
COURSE:Hard
LEVEL:6
BALLOON:5,7,10
SCOREINIT:250
SCOREDIFF:25

#START
// 高密度预热
1111111111111111,
2222222222222222,
// BPM快速变化
#BPMCHANGE:180
1111111111111111,
#BPMCHANGE:60
2222222222222222,
#BPMCHANGE:120
// 滚动速度快速变化
#SCROLL:2.0
1111111111111111,
#SCROLL:0.5
2222222222222220,
#SCROLL:1.0
// BPM与滚动复杂组合
#BPMCHANGE:160
#SCROLL:1.5
1111111111111111,
#BPMCHANGE:80
#SCROLL:0.5
2222222222222222,
#BPMCHANGE:120
#SCROLL:1.0
// 速度变化序列
#BPMCHANGE:140
#SCROLL:1.25
1110111011101110,
#BPMCHANGE:100
#SCROLL:0.75
2220222022202220,
#BPMCHANGE:120
#SCROLL:1.0
// Go-Go Time速度极限
#GOGOSTART
#BPMCHANGE:200
1111222233334444,
#BPMCHANGE:60
4444333322221111,
#GOGOEND
#BPMCHANGE:120
// 结束挑战
1111111111111111,
#END

// ============================================
// Oni Course - 速度魔王（等级8）
// 极限速度变化挑战
// ============================================
COURSE:Oni
LEVEL:8
BALLOON:5,7,10,15
SCOREINIT:400
SCOREDIFF:40

#START
// 极限预热
1111111111111111,
2222222222222222,
// BPM极限变化
#BPMCHANGE:240
1111111111111111,
#BPMCHANGE:40
2222222222222222,
#BPMCHANGE:120
// 滚动极限变化
#SCROLL:3.0
1111111111111111,
#SCROLL:0.25
2222222222222222,
#SCROLL:1.0
// BPM与滚动极限组合
#BPMCHANGE:200
#SCROLL:2.0
1111111111111111,
#BPMCHANGE:50
#SCROLL:0.25
2222222222222222,
#BPMCHANGE:120
#SCROLL:1.0
// 速度变化序列极限
#BPMCHANGE:180
#SCROLL:1.5
1111222233334444,
#BPMCHANGE:60
#SCROLL:0.5
4444333322221111,
#BPMCHANGE:120
#SCROLL:1.0
// 连打速度变化
#BPMCHANGE:160
5000000060000008,
#BPMCHANGE:80
6000000050000008,
#BPMCHANGE:120
// Go-Go Time极限
#GOGOSTART
#BPMCHANGE:240
#SCROLL:2.0
1111111111111111,
#BPMCHANGE:40
#SCROLL:0.25
2222222222222222,
#GOGOEND
#BPMCHANGE:120
#SCROLL:1.0
// 最终挑战
1111111111111111,
2222222222222222,
#BPMCHANGE:200
1111222233334444,
#BPMCHANGE:120
#END