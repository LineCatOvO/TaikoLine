TITLE:滚动与拍号测试
TITLEEN:Scroll and Measure Test
SUBTITLE:~测试滚动速度和拍号变化~
BPM:120
WAVE:test.ogg
OFFSET:0.0
MAKER:TaikoLine Test

// ============================================
// 滚动速度测试
// ============================================
COURSE:Easy
LEVEL:2
SCOREINIT:100
SCOREDIFF:10

#START
// 正常速度
1000100010001000,
2000200020002000,
// 慢速
#SCROLL:0.5
1000100010001000,
2000200020002000,
// 正常速度
#SCROLL:1.0
1000100010001000,
2000200020002000,
// 快速
#SCROLL:1.5
1000100010001000,
2000200020002000,
// 恢复
#SCROLL:1.0
1000100010001000,
#END

// ============================================
// 进阶滚动测试
// ============================================
COURSE:Normal
LEVEL:4
SCOREINIT:200
SCOREDIFF:20

#START
// 正常速度
1010101010101010,
2020202020202020,
// 慢速 0.75
#SCROLL:0.75
1010101010101010,
2020202020202020,
// 正常速度
#SCROLL:1.0
1010101010101010,
2020202020202020,
// 快速 1.25
#SCROLL:1.25
1010101010101010,
2020202020202020,
// 更快 1.5
#SCROLL:1.5
1010101010101010,
2020202020202020,
// 恢复
#SCROLL:1.0
1010101010101010,
#END

// ============================================
// 拍号测试
// ============================================
COURSE:Hard
LEVEL:6
SCOREINIT:300
SCOREDIFF:30

#START
// 4/4 拍
#MEASURE:4/4
1110111011101110,
2220222022202220,
// 3/4 拍
#MEASURE:3/4
111111,
222222,
111111,
222222,
// 2/4 拍
#MEASURE:2/4
1111,
2222,
1111,
2222,
// 恢复 4/4 拍
#MEASURE:4/4
1110111011101110,
2220222022202220,
#END

// ============================================
// 滚动与拍号组合测试
// ============================================
COURSE:Oni
LEVEL:8
SCOREINIT:400
SCOREDIFF:40

#START
// 正常
1110111011101110,
2220222022202220,
// 慢速 + 3/4 拍
#SCROLL:0.5
#MEASURE:3/4
111111,
222222,
111111,
// 快速 + 3/4 拍
#SCROLL:1.5
111111,
222222,
111111,
// 正常速度 + 4/4 拍
#SCROLL:1.0
#MEASURE:4/4
1110111011101110,
2220222022202220,
// 慢速 + 2/4 拍
#SCROLL:0.75
#MEASURE:2/4
1111,
2222,
1111,
2222,
// 快速 + 4/4 拍
#SCROLL:1.25
#MEASURE:4/4
1110111011101110,
2220222022202220,
// 恢复
#SCROLL:1.0
1111222233334444,
#END

// ============================================
// 极限滚动测试
// ============================================
COURSE:Edit
LEVEL:10
SCOREINIT:500
SCOREDIFF:50

#START
// 正常速度
1111111111111111,
2222222222222222,
// 极慢 0.25
#SCROLL:0.25
1111111111111111,
// 慢速 0.5
#SCROLL:0.5
1111111111111111,
// 慢速 0.75
#SCROLL:0.75
1111111111111111,
// 正常 1.0
#SCROLL:1.0
1111111111111111,
// 快速 1.25
#SCROLL:1.25
1111111111111111,
// 快速 1.5
#SCROLL:1.5
1111111111111111,
// 快速 2.0
#SCROLL:2.0
1111111111111111,
// 极快 3.0
#SCROLL:3.0
1111111111111111,
// 极快 4.0
#SCROLL:4.0
1111111111111111,
// 恢复
#SCROLL:1.0
// 拍号变化测试
#MEASURE:5/4
1111111111,
2222222222,
#MEASURE:6/4
111111111111,
222222222222,
#MEASURE:7/4
1111111111111,
2222222222222,
#MEASURE:4/4
// 最终
1111222233334444,
5555666677778888,
#END