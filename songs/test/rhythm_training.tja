1100110011001100,
2200220022002200,
// 八分与十六分混合
1010101011001100,
2020202022002200,
// 大音符节奏
3000300030003000,
4000400040004000,
// 节奏变化练习
1000100010001000,
1010101010101010,
1100110011001100,
// Go-Go Time节奏
#GOGOSTART
1110111011101110,
2220222022202220,
#GOGOEND
// 连打节奏
5000000000000008,
// 结束
1100220011002200,
#END

