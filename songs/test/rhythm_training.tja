// ============================================
// Easy Course - 基础节奏（等级2）
// 四分音符和八分音符练习
// ============================================
COURSE:Easy
LEVEL:2
BALLOON:5
SCOREINIT:80
SCOREDIFF:8

#START
// 四分音符练习（每拍一个音符）
1000000010000000,
2000000020000000,
1000000010000000,
2000000020000000,
// 八分音符练习（每拍两个音符）
1000100010001000,
2000200020002000,
1000100010001000,
2000200020002000,
// 四分与八分混合
1000000010001000,
2000000020002000,
1000100010000000,
2000200020000000,
// 简单节奏变化
1000100010001000,
1000000010000000,
2000200020002000,
2000000020000000,
// 结束练习
1000100020002000,
1000000020000000,
#END

// ============================================
// Normal Course - 进阶节奏（等级4）
// 八分音符组合和十六分音符入门
