// ============================================
// Easy Course - 新手入门（等级1）
// 最基础的音符练习，适合完全新手
// ============================================
COURSE:Easy
LEVEL:1
BALLOON:5
SCOREINIT:50
SCOREDIFF:5

#START
// 第一部分：认识红音符（Don）
// 每行一个音符，节奏缓慢
1000000000000000,
1000000000000000,
1000000000000000,
1000000000000000,
// 第二部分：认识蓝音符（Ka）
2000000000000000,
2000000000000000,
2000000000000000,
2000000000000000,
// 第三部分：红蓝交替
1000000020000000,
1000000020000000,
1000000020000000,
1000000020000000,
// 第四部分：连续红音符
1000100010001000,
1000100010001000,
// 第五部分：连续蓝音符
2000200020002000,
2000200020002000,
// 第六部分：简单组合
1000100020002000,
1000100020002000,
// 结束练习
1000000020000000,
1000000010000000,
#END

