TITLE:特殊音符测试
TITLEEN:Special Notes Test
SUBTITLE:~测试连打、气球、药玉~
BPM:120
WAVE:test.ogg
OFFSET:0.0
MAKER:TaikoLine Test

// ============================================
// 连打测试 (Renda)
// ============================================
COURSE:Easy
LEVEL:2
BALLOON:5,7
SCOREINIT:100
SCOREDIFF:10

#START
// 基础音符
1000100010001000,
2000200020002000,
// 短连打
5000000000000008,
// 基础音符
1000100010001000,
2000200020002000,
// 另一个短连打
5000000000000008,
// 结尾
1000100010001000,
#END

// ============================================
// 大连打测试 (Big Renda)
// ============================================
COURSE:Normal
LEVEL:4
BALLOON:5,7,10
SCOREINIT:200
SCOREDIFF:20

#START
// 基础音符
1010101010101010,
2020202020202020,
// 普通连打
5000000000000008,
// 大连打
6000000000000008,
// 混合
1010101010101010,
// 连续连打
5000000000000008,
6000000000000008,
// 结尾
1010101010101010,
#END

// ============================================
// 气球测试 (Balloon)
// ============================================
COURSE:Hard
LEVEL:6
BALLOON:5,7,10,15
SCOREINIT:300
SCOREDIFF:30

#START
// 基础音符
1110111011101110,
2220222022202220,
// 短气球 (5击)
7000000800000000,
// 基础音符
1110111011101110,
// 中气球 (7击)
7000000000000008,
// 基础音符
2220222022202220,
// 长气球 (10击)
7000000000000008,
// 基础音符
1110111011101110,
// 超长气球 (15击)
7000000000000008,
// 结尾
1111222233334444,
#END

// ============================================
// 药玉测试 (Kusudama)
// ============================================
COURSE:Oni
LEVEL:8
BALLOON:5,7,10,15,20
SCOREINIT:400
SCOREDIFF:40

#START
// 基础音符
1111111111111111,
2222222222222222,
// 药玉
9000000800000000,
// 基础音符
1111111111111111,
// 连打 + 药玉
5000000000000008,
9000000800000000,
// 气球 + 药玉
7000000800000000,
9000000800000000,
// 大连打 + 药玉
6000000000000008,
9000000800000000,
// 结尾
1111222233334444,
#END

// ============================================
// 全特殊音符测试
// ============================================
COURSE:Edit
LEVEL:10
BALLOON:5,7,10,15,20,25,30
SCOREINIT:500
SCOREDIFF:50

#START
// 基础音符
1111111111111111,
2222222222222222,
// 连打序列
5000000000000008,
5000000000000008,
5000000000000008,
// 大连打序列
6000000000000008,
6000000000000008,
6000000000000008,
// 气球序列
7000000800000000,
7000000000000008,
7000000000000008,
// 药玉序列
9000000800000000,
9000000800000000,
9000000800000000,
// 混合测试
5000000060000000,
0000000050000008,
7000000800000000,
9000000800000000,
// 极限测试
5000000060000000,
0000000050000008,
7000000800000000,
9000000800000000,
// 最终
1111222233334444,
5555666677778888,
9999999900000000,
#END