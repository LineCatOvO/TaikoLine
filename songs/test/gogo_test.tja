TITLE:Go-Go时间测试
TITLEEN:Go-Go Time Test
SUBTITLE:~测试Go-Go时间效果~
BPM:120
WAVE:test.ogg
OFFSET:0.0
MAKER:TaikoLine Test

// ============================================
// 基础 Go-Go 测试
// ============================================
COURSE:Easy
LEVEL:2
SCOREINIT:100
SCOREDIFF:10

#START
// 普通段落
1000100010001000,
2000200020002000,
1000100010001000,
2000200020002000,
// Go-Go 时间开始
#GOGOSTART
3000300030003000,
4000400040004000,
3000300030003000,
4000400040004000,
// Go-Go 时间结束
#GOGOEND
// 普通段落
1000100010001000,
2000200020002000,
#END

// ============================================
// 多次 Go-Go 测试
// ============================================
COURSE:Normal
LEVEL:4
SCOREINIT:200
SCOREDIFF:20

#START
// 第一段普通
1010101010101010,
2020202020202020,
// 第一次 Go-Go
#GOGOSTART
3030303030303030,
4040404040404040,
#GOGOEND
// 第二段普通
1010101010101010,
2020202020202020,
// 第二次 Go-Go
#GOGOSTART
3030303030303030,
4040404040404040,
#GOGOEND
// 第三段普通
1010101010101010,
2020202020202020,
// 第三次 Go-Go
#GOGOSTART
3030303030303030,
4040404040404040,
#GOGOEND
// 结尾
1010101010101010,
#END

// ============================================
// Go-Go + BPM 变化测试
// ============================================
COURSE:Hard
LEVEL:6
SCOREINIT:300
SCOREDIFF:30

#START
// 普通段落
1110111011101110,
2220222022202220,
// Go-Go + 加速
#GOGOSTART
#BPMCHANGE:140
1110111011101110,
2220222022202220,
#BPMCHANGE:160
1110111011101110,
2220222022202220,
#GOGOEND
// 恢复 BPM
#BPMCHANGE:120
// 普通段落
1110111011101110,
2220222022202220,
// Go-Go + 减速
#GOGOSTART
#BPMCHANGE:100
1110111011101110,
2220222022202220,
#BPMCHANGE:80
1110111011101110,
2220222022202220,
#GOGOEND
// 恢复
#BPMCHANGE:120
1111222233334444,
#END

// ============================================
// Go-Go + 滚动速度测试
// ============================================
COURSE:Oni
LEVEL:8
SCOREINIT:400
SCOREDIFF:40

#START
// 普通段落
1111111111111111,
2222222222222222,
// Go-Go + 慢速滚动
#GOGOSTART
#SCROLL:0.5
1111111111111111,
2222222222222222,
#SCROLL:1.0
1111111111111111,
2222222222222222,
#GOGOEND
// 普通段落
1111111111111111,
2222222222222222,
// Go-Go + 快速滚动
#GOGOSTART
#SCROLL:1.5
1111111111111111,
2222222222222222,
#SCROLL:2.0
1111111111111111,
2222222222222222,
#GOGOEND
// 恢复
#SCROLL:1.0
1111222233334444,
#END

// ============================================
// 极限 Go-Go 测试
// ============================================
COURSE:Edit
LEVEL:10
SCOREINIT:500
SCOREDIFF:50

#START
// 开场
1111222233334444,
5555666677778888,
// Go-Go 1 - 慢速
#GOGOSTART
#SCROLL:0.5
#BPMCHANGE:80
1111111111111111,
2222222222222222,
#GOGOEND
// 过渡
#SCROLL:1.0
#BPMCHANGE:120
1111222233334444,
// Go-Go 2 - 正常
#GOGOSTART
1111111111111111,
2222222222222222,
#GOGOEND
// 过渡
1111222233334444,
// Go-Go 3 - 快速
#GOGOSTART
#SCROLL:1.5
#BPMCHANGE:160
1111111111111111,
2222222222222222,
#GOGOEND
// 过渡
#SCROLL:1.0
#BPMCHANGE:120
1111222233334444,
// Go-Go 4 - 极速
#GOGOSTART
#SCROLL:2.0
#BPMCHANGE:200
1111111111111111,
2222222222222222,
3333333333333333,
4444444444444444,
#GOGOEND
// 最终
#SCROLL:1.0
#BPMCHANGE:120
1111222233334444,
5555666677778888,
9999999900000000,
#END