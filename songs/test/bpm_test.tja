TITLE:BPM变化测试
TITLEEN:BPM Change Test
SUBTITLE:~测试不同BPM变化~
BPM:120
WAVE:test.ogg
OFFSET:0.0
MAKER:TaikoLine Test

// ============================================
// 慢速测试 (60-100 BPM)
// ============================================
COURSE:Easy
LEVEL:2
SCOREINIT:100
SCOREDIFF:10

#START
// 基础 120 BPM
1000100010001000,
2000200020002000,
// 慢速 80 BPM
#BPMCHANGE:80
1000100010001000,
2000200020002000,
// 更慢 60 BPM
#BPMCHANGE:60
1000100010001000,
2000200020002000,
// 恢复 120 BPM
#BPMCHANGE:120
1000100010001000,
2000200020002000,
#END

// ============================================
// 中速测试 (100-160 BPM)
// ============================================
COURSE:Normal
LEVEL:4
SCOREINIT:200
SCOREDIFF:20

#START
// 基础 120 BPM
1010101010101010,
2020202020202020,
// 加速到 140 BPM
#BPMCHANGE:140
1010101010101010,
2020202020202020,
// 再加速到 160 BPM
#BPMCHANGE:160
1010101010101010,
2020202020202020,
// 减速到 100 BPM
#BPMCHANGE:100
1010101010101010,
2020202020202020,
// 恢复 120 BPM
#BPMCHANGE:120
1010101010101010,
2020202020202020,
#END

// ============================================
// 快速测试 (160-240 BPM)
// ============================================
COURSE:Hard
LEVEL:6
SCOREINIT:300
SCOREDIFF:30

#START
// 基础 120 BPM
1110111011101110,
2220222022202220,
// 快速 180 BPM
#BPMCHANGE:180
1110111011101110,
2220222022202220,
// 更快 200 BPM
#BPMCHANGE:200
1110111011101110,
2220222022202220,
// 极速 240 BPM
#BPMCHANGE:240
1110111011101110,
2220222022202220,
// 恢复 120 BPM
#BPMCHANGE:120
1110111011101110,
2220222022202220,
#END

// ============================================
// BPM 渐变测试
// ============================================
COURSE:Oni
LEVEL:8
SCOREINIT:400
SCOREDIFF:40

#START
// 开始 80 BPM
#BPMCHANGE:80
1111111111111111,
// 渐进加速
#BPMCHANGE:100
1111111111111111,
#BPMCHANGE:120
1111111111111111,
#BPMCHANGE:140
1111111111111111,
#BPMCHANGE:160
1111111111111111,
#BPMCHANGE:180
1111111111111111,
#BPMCHANGE:200
1111111111111111,
// 渐进减速
#BPMCHANGE:180
2222222222222222,
#BPMCHANGE:160
2222222222222222,
#BPMCHANGE:140
2222222222222222,
#BPMCHANGE:120
2222222222222222,
#BPMCHANGE:100
2222222222222222,
#BPMCHANGE:80
2222222222222222,
// 恢复
#BPMCHANGE:120
1111222233334444,
#END

// ============================================
// 极端 BPM 测试
// ============================================
COURSE:Edit
LEVEL:10
SCOREINIT:500
SCOREDIFF:50

#START
// 极慢 40 BPM
#BPMCHANGE:40
1000100010001000,
// 极快 280 BPM
#BPMCHANGE:280
1111111111111111,
// 回到极慢
#BPMCHANGE:40
2000200020002000,
// 回到极快
#BPMCHANGE:280
2222222222222222,
// 中速过渡
#BPMCHANGE:120
1010101010101010,
// 极端切换测试
#BPMCHANGE:60
1111111111111111,
#BPMCHANGE:240
2222222222222222,
#BPMCHANGE:80
3333333333333333,
#BPMCHANGE:200
4444444444444444,
// 恢复
#BPMCHANGE:120
1111222233334444,
#END