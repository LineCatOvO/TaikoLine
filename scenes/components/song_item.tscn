[gd_scene load_steps=3 format=3 uid="uid://song_item_scene"]

[ext_resource type="Script" path="res://src/ui/components/song_item.gd" id="1_script"]
[ext_resource type="Theme" uid="uid://main_menu_theme" path="res://resources/ui/themes/main_menu_theme.tres" id="2_theme"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_normal"]
bg_color = Color(0.15, 0.1, 0.35, 0.85)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_left = 10
corner_radius_bottom_right = 10
shadow_color = Color(0, 0, 0, 0.3)
shadow_size = 3
shadow_offset = Vector2(1, 1)

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_hover"]
bg_color = Color(0.25, 0.18, 0.5, 0.95)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_left = 10
corner_radius_bottom_right = 10
shadow_color = Color(0.4, 0.25, 0.7, 0.4)
shadow_size = 6
