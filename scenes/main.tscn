[gd_scene format=3 uid="uid://main_menu"]

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" instance=preload("res://scenes/components/main_background.tscn") parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Logo" instance=preload("res://scenes/components/menu_logo.tscn") parent="."]
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -200.0
offset_top = 50.0
offset_right = 200.0
offset_bottom = 150.0
grow_horizontal = 2

[node name="MenuContainer" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
offset_left = -100.0
offset_top = -75.0
offset_right = 100.0
offset_bottom = 75.0
theme_override_constants/separation = 20

[node name="StartButton" parent="MenuContainer" instance=preload("res://scenes/components/menu_button.tscn")]
layout_mode = 2
size_flags_horizontal = 4
text = "游戏开始"

[node name="OptionsButton" parent="MenuContainer" instance=preload("res://scenes/components/menu_button.tscn")]
layout_mode = 2
size_flags_horizontal = 4
text = "选项"

[node name="ExitButton" parent="MenuContainer" instance=preload("res://scenes/components/menu_button.tscn")]
layout_mode = 2
size_flags_horizontal = 4
text = "退出"

[node name="BottomInfo" instance=preload("res://scenes/components/bottom_info.tscn") parent="."]
layout_mode = 1
anchors_preset = 10
anchor_top = 1.0
anchor_bottom = 1.0
grow_vertical = 2

[connection signal="pressed" from="MenuContainer/StartButton" to="." method="_on_start_button_pressed"]
[connection signal="pressed" from="MenuContainer/OptionsButton" to="." method="_on_options_button_pressed"]
[connection signal="pressed" from="MenuContainer/ExitButton" to="." method="_on_exit_button_pressed"]
